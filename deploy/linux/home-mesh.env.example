# Image version published by the Home Mesh release workflow.
HOME_MESH_IMAGE_TAG=latest
HOME_MESH_API_IMAGE=ghcr.io/phantonull/home-mesh-api
HOME_MESH_WEB_IMAGE=ghcr.io/phantonull/home-mesh-web

# Browser entry point. Keep loopback for a local reverse proxy, or use the
# Linux host's LAN address for access from trusted LAN clients.
HOME_MESH_WEB_BIND=127.0.0.1
HOME_MESH_WEB_PORT=3000
HOME_MESH_ALLOWED_HOSTS=

# Private bridge used only by Nginx to reach the host-network API listener.
# Change both values if this range overlaps the host LAN, VPN, or Docker pools.
HOME_MESH_PROXY_SUBNET=172.30.0.0/24
HOME_MESH_PROXY_GATEWAY=172.30.0.1
HOME_MESH_API_PORT=18080

# Use the host resolver or a LAN resolver such as Pi-hole.
HOME_MESH_DNS_SERVER=127.0.0.53

# Generate unique values during installation. Never reuse example values.
HOME_MESH_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
HOME_MESH_MASTER_KEY_VERSION=2
HOME_MESH_PREVIOUS_MASTER_KEYS=
HOME_MESH_SESSION_SECRET=replace-with-a-long-random-session-secret
HOME_MESH_SESSION_DURATION=1h
HOME_MESH_BOOTSTRAP_ADMIN_USERNAME=root
HOME_MESH_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-first-start-password

HOME_MESH_SEED_DEMO_DATA=false
HOME_MESH_DISCOVERY_ALLOW_PUBLIC=false
HOME_MESH_SCAN_INTERVAL=30s
